# 必填。在 https://aistudio.google.com 的 API keys 页面创建
GEMINI_API_KEY=

# 模型代码。想试 3.5 Flash-Lite，就把 AI Studio 里显示的 model code 填在这里
GEMINI_MODEL=gemini-3.1-flash-lite

# 两次 Ctrl+C 之间的最大间隔（毫秒）
DOUBLE_PRESS_WINDOW_MS=400

# 输入超过这个字符数就拒绝处理，避免误把整篇文档发出去
MAX_INPUT_CHARS=4000

# 单次请求超时（秒）
REQUEST_TIMEOUT_S=10

# 是否在日志里打印文本内容。默认关闭，只记录长度和耗时
LOG_TEXT=false
